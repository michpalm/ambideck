{
  "name": "ambideck",
  "version": "0.1.0",
  "description": "Ambilight for the ROG Xbox Ally: the stick lights follow what's on screen",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
